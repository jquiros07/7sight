APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=video_intelligence_platform
DB_USERNAME=root
DB_PASSWORD=

# Used by docker-compose.yml for the mysql container and the app/analysis-worker
# containers' own DB connection. Change these before running on a real server.
MYSQL_PASSWORD=secret
MYSQL_ROOT_PASSWORD=root_secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Analysis worker (analysis-worker/) - which provider implements the
# AnalysisProvider interface. Only "rekognition" exists today.
ANALYSIS_PROVIDER=rekognition

# Minimum confidence (0-100) Rekognition must have to return a detected
# label. Rekognition defaults to 50 if unset, which lets through a lot of
# low-confidence noise.
REKOGNITION_MIN_CONFIDENCE=75

# laravel/ai - powers the "Generate insights" feature on the video results
# page (app/Ai/Agents/*). Uses Google's Gemini Flash.
GEMINI_API_KEY=

# Shared secret the analysis-worker sends as the X-Internal-Token header when
# it calls back into Laravel to trigger insight generation once a video's
# analysis jobs all complete. Set this to a random string.
INTERNAL_API_TOKEN=

# Activates the local Vite dev server (docker-compose.yml's "vite" service).
# Leave this unset in production - it should serve the pre-built assets baked
# into the "production" Docker image target instead of running a dev server.
COMPOSE_PROFILES=dev

VITE_APP_NAME="${APP_NAME}"

# Error tracking - create a project at sentry.io and paste its DSN into
# SENTRY_DSN below. The PHP app falls back to SENTRY_DSN when
# SENTRY_LARAVEL_DSN isn't set, so one DSN covers both by default - only
# uncomment SENTRY_LARAVEL_DSN if the app should report to a different
# Sentry project than the Python analysis worker. Note: env() only falls
# back when a var is entirely absent, not when it's present-but-empty, so
# leave this line commented out rather than blank.
# SENTRY_LARAVEL_DSN=

# Error tracking, shared by both the app (as a fallback) and the Python
# analysis worker.
SENTRY_DSN=

# Performance tracing sample rate, shared by both the app and the Python
# analysis worker. 1.0 = trace every request/job; leave blank/unset to
# disable tracing entirely. Lower this before real production traffic to
# control event volume/cost.
SENTRY_TRACES_SAMPLE_RATE=1.0

# spatie/laravel-pdf (video results PDF report) - points Browsershot at the
# system Chromium and isolated puppeteer-core install baked into the app
# image (see Dockerfile), instead of its own auto-detection.
LARAVEL_PDF_NODE_BINARY=/usr/bin/node
LARAVEL_PDF_NPM_BINARY=/usr/bin/npm
LARAVEL_PDF_CHROME_PATH=/usr/bin/chromium
LARAVEL_PDF_NODE_MODULES_PATH=/var/www/html/docker/browsershot/node_modules
LARAVEL_PDF_NO_SANDBOX=true
