your-domain.com {
    # Live camera HLS streams (MediaMTX). handle_path strips the /hls prefix
    # before proxying, since MediaMTX itself serves paths at "/", e.g.
    # /hls/camera-1/index.m3u8 here -> /camera-1/index.m3u8 on mediamtx:8888.
    # Must come before the catch-all reverse_proxy below - Caddy matches in order.
    handle_path /hls/* {
        reverse_proxy mediamtx:8888
    }

    reverse_proxy app:80
}
